    "@xyflow/react": "^12.3.5",
    "framer-motion": "^11.11.7",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "zustand": "^5.0.0",
    "nuqs": "^2.0.4",
